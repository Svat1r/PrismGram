using "ui/basic.style";
using "ui/colors.palette";

// Floating bottom navigation under the chat list.
nexoNavBarMargin: margins(10px, 4px, 10px, 10px);
nexoNavBarHeight: 54px;
nexoNavBarRadius: 27px;
nexoNavBarInner: margins(5px, 5px, 5px, 5px);
nexoNavItemRadius: 22px;
nexoNavIconTop: 3px;
nexoNavLabelBottom: 6px;
nexoNavLabelFont: font(11px);
nexoNavBadgeFont: font(10px semibold);
nexoNavBadgeHeight: 15px;
nexoNavBadgePadding: 4px;
nexoNavBadgeShift: point(12px, 2px);

// Proxy chip inside the chat list search field.
nexoProxyChipHeight: 26px;
nexoProxyChipPadding: margins(7px, 0px, 10px, 0px);
nexoProxyChipSkip: 4px;
nexoProxyChipRight: 5px;
nexoProxyChipFont: font(12px);
nexoProxyChipIconOn: icon {{ "proxy_on", windowActiveTextFg }};
nexoProxyChipIconOff: icon {{ "proxy_off", windowSubTextFg }};

// Theme cards in Settings > Appearance.
nexoThemeCardSize: size(58px, 78px);
nexoThemeCardSkip: 8px;
nexoThemeCardRadius: 12px;
nexoThemeCardBorder: 2px;
nexoThemeCardPadding: margins(22px, 6px, 22px, 6px);
nexoThemeNameTop: 6px;
nexoThemeNameFont: font(12px);
